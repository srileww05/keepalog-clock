{
  "manifest_version": 3,
  "name": "Flow Log Timer",
  "version": "1.1",
  "description": "Stopwatch and timer that logs the real clock time of every event.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {
    "128": "icon.png"
  }
}